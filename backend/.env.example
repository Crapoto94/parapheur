# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs réelles.
#
# Aucune donnée de paramétrage n'est stockée en base SQLite : ce .env fournit
# les valeurs par défaut. Les réglages modifiables depuis l'administration
# (paramètres du parapheur, stockage documentaire, Alfresco) sont écrits dans
# un fichier JSON local (data/settings.json, cf. SETTINGS_FILE).

# ── PostgreSQL (base AppDSI ivry_admin, schéma hub_parapheur) ────────────────
POSTGRES_HOST=10.103.130.106
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ivrypassword

# ── Clé de signature des jetons JWT (DOIT être identique à AppDSI pour que les
#     jetons et les liens générés restent valides de part et d'autre). ────────
JWT_SECRET=changez-moi

# ── Liens publics (e-mails de signature + QR code de vérification) ───────────
# Domaine public du front (back-office) et du front DMZ.
PARAPHEUR_PUBLIC_URL=https://parapheur.ivry94.fr
APP_BASE_URL=https://parapheur.ivry94.fr
FRONTEND_URL=https://parapheur.ivry94.fr

# Port d'écoute du backend.
#  - En Docker : laisser 3001 (le compose publie ${BACKEND_PORT:-3004}:3001).
#  - En local (hors Docker) : 3004 pour coller au proxy des fronts et éviter
#    le 3001 d'AppDSI.
PORT=3004

# ── Compte administrateur local (remplace la table SQLite `users`) ───────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changez-moi
# Variante : hash bcrypt du mot de passe (prioritaire sur ADMIN_PASSWORD s'il est défini).
# ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@ivry94.fr
ADMIN_DISPLAY_NAME=Administrateur
# Mot de passe universel historique (dev/test) ; laisser vide pour le désactiver.
BYPASS_PASSWORD=çflcBr32

# ── Paramétrage du parapheur (modifiable ensuite depuis /admin) ──────────────
# PARAPHEUR_SEAL_ENABLED=true
# PARAPHEUR_BULK_SIGN_MENTION=
# PARAPHEUR_NOTIFY_INTERVAL_MINUTES=2

# ── Stockage documentaire (fichier settings.json surcharge le .env) ──────────
# backend : filesystem | alfresco (ou both via DOCUMENTS_BACKEND)
STORAGE_BACKEND=filesystem
STORAGE_ROOT_PATH=C:\dev\parapheur\backend
# STORAGE_LOGIN=
# STORAGE_PASSWORD=
# STORAGE_DOMAIN=

# ── GED Alfresco ─────────────────────────────────────────────────────────────
# ALFRESCO_URL=
# ALFRESCO_USERNAME=
# ALFRESCO_PASSWORD=
# ALFRESCO_ROOT_PATH=

# Backend documentaire global (filesystem | alfresco | both).
# DOCUMENTS_BACKEND=filesystem

# ── Repli mailer local (l'API Ville/APM reste la voie prioritaire) ───────────
MAIL_GLOBAL_ENABLE=true
MAIL_USE_API=true
MAIL_SENDER_EMAIL=
MAIL_SENDER_NAME=DSI Hub
# MAIL_API_KEY=            # clé Brevo (si MAIL_USE_API=true)
# MAIL_API_URL=https://api.brevo.com/v3/smtp/email
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_SMTP_SECURE=

# Fichier JSON des réglages éditables (par défaut : backend/data/settings.json).
# SETTINGS_FILE=

# Désactive les relances automatiques en développement local.
DISABLE_PARAPHEUR_CRON=1
