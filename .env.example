# Copier en ".env" (non versionné) et renseigner les valeurs réelles.

# ── PostgreSQL (base AppDSI ivry_admin, schéma hub_parapheur) ────────────────
POSTGRES_HOST=10.103.130.106
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ivrypassword

# ── Clé JWT (identique à AppDSI pour partager jetons et liens signés) ────────
JWT_SECRET=changez-moi

# ── Liens publics (e-mails de signature + QR code de vérification) ───────────
PARAPHEUR_PUBLIC_URL=https://parapheur.ivry94.fr
APP_BASE_URL=https://parapheur.ivry94.fr
FRONTEND_URL=https://parapheur.ivry94.fr

# ── Front DMZ ────────────────────────────────────────────────────────────────
# En stack complète, laisser http://backend:3001. En DMZ séparée, mettre l'IP
# LAN de l'hôte qui publie le backend (règle firewall DMZ → LAN, TCP 3004).
BACKEND_URL=http://backend:3001
PARAPHEUR_DOMAIN=parapheur.ivry94.fr

# ── Ports publiés sur l'hôte (différents de ceux d'AppDSI) ───────────────────
# API backend (conteneur 3001), back-office (conteneur 5173), front DMZ (conteneur 5177).
BACKEND_PORT=3004
BACKOFFICE_PORT=3005
DMZ_PORT=3006
