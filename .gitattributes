# Normalisation des fins de ligne : les images Linux (entrypoint.sh, Dockerfile,
# templates nginx) doivent rester en LF même en clonant sur Windows.
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.template text eol=lf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.sqlite binary
*.db binary
*.woff binary
*.woff2 binary
