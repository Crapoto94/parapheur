# Copier ce fichier en ".env" (non versionné) et renseigner les valeurs réelles.

# ── PostgreSQL (base AppDSI ivry_admin, schéma hub_parapheur) ────────────────
POSTGRES_HOST=10.103.130.106
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ivrypassword

# ── Clé de signature des jetons JWT (DOIT être identique à AppDSI pour que les
#     jetons et les liens générés restent valides de part et d'autre). ────────
JWT_SECRET=changez-moi

# ── Liens publics (e-mails de signature + QR code de vérification) ───────────
# Domaine public du front (back-office) et du front DMZ.
PARAPHEUR_PUBLIC_URL=https://parapheur.ivry94.fr
APP_BASE_URL=https://parapheur.ivry94.fr
FRONTEND_URL=https://parapheur.ivry94.fr

# Port d'écoute du backend (3001 par défaut).
PORT=3001
